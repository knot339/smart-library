# ==============================================================================
# การตั้งค่าสำหรับ Frontend (ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกนำไปใช้ในฝั่ง Client)
# ==============================================================================

POSTGRES_USER={POSTGRES_USER}
POSTGRES_PASSWORD={POSTGRES_PASSWORD}
POSTGRES_DB={POSTGRES_DB}
DB_HOST={DB_HOST}
DB_PORT={DB_PORT}

# ส่วน API
OPAC_API_URL={OPAC_API_URL}
OPAC_API_TOKEN={OPAC_API_TOKEN}

# ส่วน SMTP (ส่งอีเมลแจ้งเตือนตอนตู้เต็ม) — รองรับ SMTP+STARTTLS พอร์ต 587
SMTP_HOST={SMTP_HOST}
SMTP_PORT={SMTP_PORT}
SMTP_USER={SMTP_USER}
SMTP_PASSWORD={SMTP_PASSWORD}
SMTP_FROM={SMTP_FROM}

# บัญชีเจ้าหน้าที่คนแรกสำหรับหน้า /login (login เดียวใช้ทั้งหน้า /dashboard และ /admin — สิทธิ์เข้า
# แต่ละหน้าตั้งค่าแยกรายบัญชีได้ที่แท็บ "บัญชีผู้ใช้" ใน /admin) สร้างให้อัตโนมัติตอน backend เริ่มทำงาน
# ครั้งแรกถ้ายังไม่เคยมี user ไหนในระบบเลย (ได้สิทธิ์เข้าทั้ง 2 หน้า) ไม่ตั้งค่าไว้จะ fallback เป็น
# admin/changeme123 (ควรตั้งรหัสผ่านจริงก่อนใช้งานจริง)
ADMIN_USERNAME=admin
ADMIN_PASSWORD={ADMIN_PASSWORD}