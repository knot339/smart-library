# ==============================================================================
# การตั้งค่าสำหรับ Frontend (ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกนำไปใช้ในฝั่ง Client)
# ==============================================================================

# URL สำหรับเชื่อมต่อ API และ WebSocket ของ Backend (ต้องเป็น URL ที่เบราว์เซอร์เข้าถึงได้)
NEXT_PUBLIC_API_BASE_URL="http://192.168.1.10:8080/api"
NEXT_PUBLIC_WS_BASE_URL="ws://192.168.1.10:8080/ws/tablet"

# IP ของกล้อง (สำหรับดึงสตรีมวิดีโอ)
NEXT_PUBLIC_CAMERA_FRONT_URL="http://192.168.1.11:81/stream"
NEXT_PUBLIC_CAMERA_INSIDE_URL="http://192.168.1.12:81/stream"

# IP ระบบบันทึกภาพ/วิดีโอ (สำหรับดึงข้อมูลย้อนหลัง)
NEXT_PUBLIC_CAMERA_FRONT_RECORDINGS_URL="http://192.168.1.11:82"
NEXT_PUBLIC_CAMERA_INSIDE_RECORDINGS_URL="http://192.168.1.12:82"

# IP ระบบไฟล์ (สำหรับจัดการไฟล์รูปภาพหรือไฟล์ต่างๆ)
NEXT_PUBLIC_CAMERA_FRONT_FILE_URL="http://192.168.1.11:83"
NEXT_PUBLIC_CAMERA_INSIDE_FILE_URL="http://192.168.1.12:83"

POSTGRES_USER={POSTGRES_USER}
POSTGRES_PASSWORD={POSTGRES_PASSWORD}
POSTGRES_DB={POSTGRES_DB}
DB_HOST={DB_HOST}
DB_PORT={DB_PORT}

# ส่วน API
OPAC_API_URL={OPAC_API_URL}
OPAC_API_TOKEN={OPAC_API_TOKEN}